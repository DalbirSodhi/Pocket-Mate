  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@supabase/supabase-js": "^2.110.2",
    "expo": "~54.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-notifications": "~0.32.17",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.27.0",
    "papaparse": "^5.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test",
    "lint": "expo lint",
    "audit:production": "node ./scripts/audit-production.cjs",
    "release:check": "node ./scripts/validate-release-config.cjs",
    "build:development:ios": "npx eas-cli@21.4.0 build --platform ios --profile development",
    "build:preview:ios": "npx eas-cli@21.4.0 build --platform ios --profile preview",
    "build:preview:android": "npx eas-cli@21.4.0 build --platform android --profile preview",
    "build:production": "npx eas-cli@21.4.0 build --platform all --profile production",
    "submit:production:ios": "npx eas-cli@21.4.0 submit --platform ios --profile production"
  },
  "private": true,
  "overrides": {
    "postcss": "8.5.25"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0"
