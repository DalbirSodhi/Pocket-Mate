{
  "expo": {
    "name": "Pocket-Mate",
    "slug": "pocket-mate",
    "scheme": "pocketmate",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7a15c436-d6e0-414d-a4b7-106ef1a296b9",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dalbirsodhi.pocketmate",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.dalbirsodhi.pocketmate",
      "adaptiveIcon": {
        "backgroundColor": "#101C2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#C56F42",
          "defaultChannel": "pocket-mate-reminders"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "7a15c436-d6e0-414d-a4b7-106ef1a296b9"
      }
    },
    "owner": "dalbir-tech"
  }
}
